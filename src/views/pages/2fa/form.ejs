<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verificación 2FA</title>
  <link rel="stylesheet" href="/css/ui-login.css">
  <script>window.APP_VIEWPORT_RESET = true</script>
  <script src="/js/helpers/viewport-height-helper.js"></script>
</head>

<body class="viewport-session-page login-page">
  <main class="login-shell">
    <section class="login-container login-panel" aria-labelledby="twofa-title">
      <header class="login-header">
        <p class="login-brand">App Contable</p>
        <h1 id="twofa-title">Verificación en dos pasos</h1>
        <p class="login-intro">Ingresa el código enviado a tu correo</p>
      </header>

      <% if (error) { %>
        <p class="login-error" role="alert"><%= error %></p>
      <% } %>

      <form method="POST" action="/2fa" class="login-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="login-field">
          <label for="twofa-code">Código de verificación</label>
          <input
            id="twofa-code"
            class="login-input"
            type="text"
            name="code"
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9]{6}"
            maxlength="6"
            required
            aria-describedby="twofa-hint"
          >
          <span id="twofa-hint" class="login-hint">Código de 6 dígitos</span>
        </div>

        <button type="submit" class="login-submit">Verificar</button>
      </form>
    </section>
  </main>
</body>
</html>
