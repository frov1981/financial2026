<section class="admin-page admin-log-reader">
  <script>window.USER_ID = "<%= USER_ID %>"</script>
  <script>window.ADMIN_LOG_FILE_NUMBER = <%= selectedFileNumber %></script>
  <div class="admin-reader-heading">
    <h1>Visor <span class="admin-selected-file"><%= selectedFile %></span></h1>
  </div>

  <form id="log-reader-filter-form" action="/admin/logs" method="get" class="admin-log-filter">
    <input type="hidden" name="fileNumber" value="<%= selectedFileNumber %>">
    <%- include('../../partials/buttons/btn-back', {
      href: '/admin',
      title: 'Volver a los archivos de registro',
      text: 'Volver'
    }) %>
    <button id="log-type-filter-button" class="ui-btn ui-btn-default admin-log-toolbar-button" type="button"
      aria-haspopup="dialog" title="Filtrar registros" aria-label="Filtrar registros">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5h16l-6.5 7.5V19l-3 1v-7.5L4 5z"/>
      </svg>
      <span class="ui-btn-text">Filtrar</span>
    </button>
    <label class="sr-only" for="log-filter">Filtrar líneas del registro</label>
    <input id="log-filter" type="search" name="filter" value="<%= filter %>"
      placeholder="Filtrar registros..." aria-label="Filtrar registros">
    <button id="log-refresh-button" class="ui-btn ui-btn-default admin-log-toolbar-button" type="button"
      title="Actualizar registros" aria-label="Actualizar registros">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7v5h-5M4 17v-5h5m10-1a7 7 0 0 0-12.2-4.7L4 8m16 8-2.8 2.7A7 7 0 0 1 5 13"/>
      </svg>
      <span class="ui-btn-text">Actualizar</span>
    </button>
  </form>

  <dialog id="log-type-filter-modal" class="admin-log-type-modal" aria-labelledby="log-type-filter-title">
    <div class="admin-log-type-modal-content">
      <h2 id="log-type-filter-title">Filtros de registros</h2>
      <div class="admin-log-user-filter">
        <label for="log-user-filter-input">Usuario</label>
        <div class="autocomplete" data-items='<%= JSON.stringify(logUserOptions) %>'
          data-default-id="<%= selectedLogUser %>" data-placeholder="Todos">
          <input id="log-user-filter-input" type="text" class="autocomplete-input" autocomplete="off"
            value="<%= logUserOptions.find(option => option.id === selectedLogUser)?.name || '' %>"
            aria-label="Filtrar por usuario">
          <input id="log-user-filter" class="autocomplete-hidden" type="hidden" name="userId"
            value="<%= selectedLogUser %>" form="log-reader-filter-form">
          <div class="autocomplete-panel"></div>
        </div>
      </div>
      <div class="admin-log-user-filter">
        <label for="log-event-filter-input">Evento</label>
        <div class="autocomplete" data-items='<%= JSON.stringify(logEventOptions) %>'
          data-default-id="<%= eventFilter || 'all' %>" data-placeholder="Todos los eventos">
          <input id="log-event-filter-input" type="text" class="autocomplete-input" autocomplete="off"
            value="<%= logEventOptions.find(option => option.id === eventFilter)?.name || 'Todos' %>"
            aria-label="Filtrar por evento">
          <input id="log-event-filter" class="autocomplete-hidden" type="hidden" name="eventFilter"
            value="<%= eventFilter || 'all' %>" form="log-reader-filter-form">
          <div class="autocomplete-panel"></div>
        </div>
      </div>
      <fieldset class="admin-log-type-options">
        <legend>Niveles del log</legend>
        <% ['TRACE', 'DEBUG', 'INFO', 'WARN', 'ERROR', 'FATAL'].forEach(type => { %>
          <label>
            <input type="checkbox" name="log-type" value="<%= type %>"
              <%= selectedLogTypes.length === 0 || selectedLogTypes.includes(type) ? 'checked' : '' %>>
            <span><%= type %></span>
          </label>
        <% }) %>
      </fieldset>
      <div class="admin-log-type-modal-actions">
        <button id="log-type-filter-cancel" class="ui-modal-btn ui-modal-btn-neutral" type="button">Cancelar</button>
        <button id="log-type-filter-apply" class="ui-modal-btn ui-modal-btn-primary" type="button">Aplicar</button>
      </div>
    </div>
  </dialog>

  <p id="log-reader-status" class="admin-reader-status" role="status"><%= displayedLines %> de <%= totalLines %> líneas</p>
  <div id="log-content" class="admin-log-content ui-table-wrapper" role="region" aria-label="Registros, del más reciente al más antiguo" tabindex="0">
    <table class="ui-table admin-log-table">
      <colgroup>
        <col class="admin-log-expand-column">
        <col class="admin-log-time-column">
        <col class="admin-log-level-column">
        <col class="admin-log-event-column">
        <col class="admin-log-method-column">
        <col class="admin-log-copy-column">
      </colgroup>
      <thead>
        <tr>
          <th class="ui-th col-left admin-log-detail-heading" scope="col" aria-label="Detalle">•</th>
          <th class="ui-th col-left" scope="col">Tiempo</th>
          <th class="ui-th col-left" scope="col">Nivel</th>
          <th class="ui-th col-left" scope="col">Evento</th>
          <th class="ui-th col-left" scope="col">Método</th>
          <th class="ui-th col-left admin-log-copy-heading" scope="col">JSON</th>
        </tr>
      </thead>
      <tbody id="admin-log-records">
        <% records.forEach((record, index) => { %>
          <tr class="admin-log-row <%= record.level ? `admin-log-level-${record.level.toLowerCase()}` : '' %>" data-detail-id="admin-log-detail-<%= index %>" data-raw-json="<%= encodeURIComponent(record.rawLine) %>">
            <td>
              <button class="admin-log-expand" type="button" aria-expanded="false" aria-controls="admin-log-detail-<%= index %>" aria-label="Expandir propiedades del registro">
                <span aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </span>
              </button>
            </td>
            <td class="admin-log-time" data-time="<%= record.time || '' %>"><%= record.time || '—' %></td>
            <td class="admin-log-level-name"><%= record.levelName || '—' %></td>
            <td class="admin-log-event-name"><%= record.eventName || '—' %></td>
            <td class="admin-log-method"><%= record.method || '—' %></td>
            <td class="admin-log-copy-cell">
              <button class="admin-log-copy" type="button" aria-label="Copiar registro JSON" title="Copiar JSON">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"/></svg>
              </button>
            </td>
          </tr>
          <tr id="admin-log-detail-<%= index %>" class="admin-log-detail-row" hidden>
            <td colspan="6">
              <div class="admin-log-detail-content">
                <table class="ui-table admin-log-properties">
                  <tbody>
                    <% record.properties.forEach(property => { %>
                      <tr class="<%= property.name === 'Evento' ? 'admin-log-event-property' : '' %>"><th scope="row"><%= property.name %></th><td><%= property.value %></td></tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<script src="/js/helpers/icon-helper.js"></script>
<script src="/js/helpers/autocomplete-helper.js"></script>
<script src="/js/pages/admin/log-reader.js"></script>
