<div class="max-w-xl mx-auto ui-page">
  <div class="ui-header">
    <h1 class="ui-title">Programar balances</h1>
  </div>

  <form method="post" action="/notifications/schedule" class="ui-form notification-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="timezone" value="<%= notification.timezone %>">
    <h2 class="notification-form-title"><%= notification.title %></h2>

    <% if (errors.schedule) { %>
      <p class="form-error"><%= errors.schedule %></p>
    <% } %>

    <label for="send_day">Día</label>
    <select id="send_day" name="send_day" required>
      <% days.forEach(day => { %>
        <option value="<%= day.value %>" <%= Number(notification.send_day) === day.value || notification.send_day === day.name ? 'selected' : '' %>><%= day.label %></option>
      <% }) %>
    </select>

    <label for="send_time">Hora</label>
    <input id="send_time" name="send_time" type="time" step="60" value="<%= notification.send_time %>" required>

    <div class="notification-form-actions">
      <%- include('../../partials/btn-cancel-batch', {
        href: '/notifications',
        title: 'Cancelar programación',
        text: 'Cancelar'
      }) %>
      <% if (notification.exists) { %>
        <%- include('../../partials/btn-accept-batch', {
          id: 'notification-save',
          type: 'submit',
          name: 'mode',
          value: 'save',
          title: 'Guardar programación',
          text: 'Guardar horario'
        }) %>
      <% } %>
      <% if (notification.enabled) { %>
        <button type="submit" name="mode" value="disable" class="ui-btn">Deshabilitar</button>
      <% } else { %>
        <button type="submit" name="mode" value="enable" class="ui-btn ui-btn-primary">Habilitar</button>
      <% } %>
    </div>
  </form>
</div>