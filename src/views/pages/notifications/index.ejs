<div class="max-w-4xl mx-auto ui-page notifications-page">
  <div class="ui-header">
    <h1 class="ui-title">Programación semanal</h1>
  </div>

  <div class="ui-scroll-area">
    <div class="notifications-mobile">
      <article class="ui-card notification-card">
        <div class="ui-card-body">
          <h2 class="notification-card-title"><%= notification.title %></h2>
          <dl class="notification-details">
            <div><dt>Estado</dt><dd><%= notification.enabled ? 'Habilitado' : 'Deshabilitado' %></dd></div>
            <div><dt>Día</dt><dd><%= days.find(day => day.name === notification.send_day).label %></dd></div>
            <div><dt>Hora</dt><dd><%= notification.send_time %></dd></div>
          </dl>
          <a href="/notifications/schedule" class="ui-btn ui-btn-primary">Configurar</a>
        </div>
      </article>
    </div>

    <div class="ui-table-wrapper">
      <table class="ui-table">
        <thead>
          <tr>
            <th>Programación</th>
            <th>Día</th>
            <th>Hora</th>
            <th>Estado</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><%= notification.title %></td>
            <td><%= days.find(day => day.name === notification.send_day).label %></td>
            <td><%= notification.send_time %></td>
            <td><%= notification.enabled ? 'Habilitado' : 'Deshabilitado' %></td>
            <td><a href="/notifications/schedule" class="ui-btn ui-btn-primary">Configurar</a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>