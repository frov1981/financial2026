<div
  id="message-box-modal"
  class="ui-modal message-box-modal hidden"
  role="alertdialog"
  aria-modal="true"
  aria-labelledby="message-box-message"
>
  <div class="message-box-content">
    <div id="message-box-icons" class="message-box-icons" aria-hidden="true">
      <svg data-message-box-icon="info" class="message-box-icon message-box-icon-info hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 16v-4"></path>
        <path d="M12 8h.01"></path>
      </svg>
      <svg data-message-box-icon="warn" class="message-box-icon message-box-icon-warn hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="m10.3 3.9-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3.1l-8-14a2 2 0 0 0-3.4 0Z"></path>
        <path d="M12 9v4"></path>
        <path d="M12 17h.01"></path>
      </svg>
      <svg data-message-box-icon="error" class="message-box-icon message-box-icon-error hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="m15 9-6 6"></path>
        <path d="m9 9 6 6"></path>
      </svg>
    </div>
    <p id="message-box-message" class="message-box-message"></p>
    <button id="message-box-accept" class="ui-modal-btn ui-modal-btn-primary" type="button">Aceptar</button>
  </div>
</div>
