<nav class="app-navbar" aria-label="Navegación principal">
  <div class="navbar-inner">
    <div class="navbar-top">
      <a class="navbar-brand" href="/home">App Contable <span>V1</span></a>

      <div class="navbar-balances" aria-label="Balances">
        <% if (typeof net_balance !== 'undefined') { %>
          <span class="navbar-net-balance <%= net_balance > 0 ? 'positive' : 'negative' %>"><%= net_balance.toFixed(2) %></span>
        <% } %>

        <% if (typeof hidePendingBalancesInNavbar === 'undefined' || !hidePendingBalancesInNavbar) { %>
          <% if (typeof payable_balance !== 'undefined') { %>
            <span class="navbar-payable_balance"><%= payable_balance.toFixed(2) %></span>
          <% } %>
          <% if (typeof receivable_balance !== 'undefined') { %>
            <span class="navbar-receivable_balance"><%= receivable_balance.toFixed(2) %></span>
          <% } %>
        <% } %>
      </div>

      <button id="mobile-menu-btn" class="navbar-menu-btn" type="button"
        aria-label="Abrir menú" aria-controls="navbar-links" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <ul id="navbar-links" class="navbar-links">
      <li><a href="/home">Inicio</a></li>
      <li><a href="/accounts">Cuentas</a></li>
      <li><a href="/categories">Categorías</a></li>
      <li><a href="/transactions">Transacciones</a></li>
      <li><a href="/payables">Cuentas por Pagar</a></li>
      <li><a href="/receivables">Cuentas por Cobrar</a></li>
      <li><a href="/notifications">Programación</a></li>
      <li><a href="/settings">Configuraciones</a></li>
      <li><a href="/logout">Cerrar Sesión</a></li>
    </ul>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn')
  const menu = document.getElementById('navbar-links')

  btn.addEventListener('click', () => {
    const isExpanded = btn.getAttribute('aria-expanded') === 'true'
    btn.setAttribute('aria-expanded', String(!isExpanded))
    btn.setAttribute('aria-label', isExpanded ? 'Abrir menú' : 'Cerrar menú')
    menu.classList.toggle('is-open', !isExpanded)
  })
</script>
